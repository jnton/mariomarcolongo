---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/portfolio-v3.css";
import "../styles/integrity.css";
import D from "../../data/source.js";
import C from "../../data/investigation-cases.js";

const pageTitle = "Knowledge Integrity & Investigation Work Samples — Mario Marcolongo";
const pageDescription = "Public, attributable work samples demonstrating archival OSINT, source-quality review, biomedical evidence synthesis, provenance and evidence-bound investigation methods.";
const records = C.all.map((record, index) => ({
  ...record,
  number: String(index + 1).padStart(2, "0")
}));

const methods = [
  ["Question decomposition", "Translate a broad claim into identities, dates, locations, source types, legal or scientific stages and falsifiable sub-questions."],
  ["Search & recovery", "Use advanced web and scholarly search, archives, URL reconstruction, bibliographic databases and public revision histories to recover attributable evidence."],
  ["Source hierarchy", "Prioritize primary records, court or institutional documents, official datasets, scholarly literature and reputable independent reporting."],
  ["Cross-source checking", "Compare independent records, dates, wording and metadata; document unresolved disagreement rather than forcing certainty."],
  ["Taxonomy & entity reconciliation", "Resolve naming variants, organizations, identifiers, scientific categories and relationships across prose and structured records."],
  ["Evidence-bound reporting", "Separate what a source directly supports from allegation, inference, community decision, platform label or unverified interpretation."]
];
---

<Layout title={pageTitle} description={pageDescription} canonical="https://mariomarcolongo.com/integrity.html">
  <Fragment slot="head">
    <script is:inline>document.documentElement.classList.add("v3-js");</script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      name: pageTitle,
      description: pageDescription,
      url: "https://mariomarcolongo.com/integrity.html",
      mainEntity: { "@id": "https://mariomarcolongo.com/#person" },
      about: ["Knowledge integrity", "Open-source research", "Archival research", "Source provenance", "Trust and safety"]
    })}></script>
  </Fragment>

  <SiteNav activePage="integrity" />

  <main class="v3-page integrity-page">
    <section class="integrity-hero">
      <div class="v3-kicker v3-enter" style="--enter-delay:60ms">Knowledge integrity · public work samples</div>
      <h1 class="v3-enter" style="--enter-delay:130ms">Investigation is useful only when the evidence trail survives scrutiny.</h1>
      <p class="v3-enter" style="--enter-delay:210ms">This page collects attributable examples of archival record recovery, legally sensitive chronology, source-quality review, biomedical evidence synthesis, health-information monitoring and research-data provenance. It shows the reasoning and records behind the work rather than relying on a generic OSINT tool list.</p>
      <div class="v3-hero-actions v3-enter" style="--enter-delay:290ms">
        <a class="v3-button v3-button-primary" href="/cv-integrity.html">Trust & Integrity CV →</a>
        <a class="v3-button" href="#records">Inspect case records</a>
        <a class="v3-button v3-button-quiet" href="/">Back to portfolio</a>
      </div>
    </section>

    <section class="integrity-principles v3-reveal" aria-label="Evidence principles">
      <article><strong>Public first</strong><span>Use records a reviewer can inspect directly.</span></article>
      <article><strong>Attribution exact</strong><span>Link to the revision, discussion or published work that shows the contribution.</span></article>
      <article><strong>Scope explicit</strong><span>Separate fact, allegation, inference and collaborative outcome.</span></article>
      <article><strong>Privacy preserved</strong><span>Do not republish unnecessary personal data or private correspondence.</span></article>
    </section>

    <section class="v3-section" id="records">
      <div class="v3-section-head v3-reveal">
        <div>
          <div class="v3-kicker">Public case records</div>
          <h2>Six investigation surfaces.</h2>
        </div>
        <p>Archival legal records, disputed biographies, biomedical taxonomies, fast-moving health information, research entities and historical provenance require different tools. The common discipline is traceability.</p>
      </div>

      <div class="integrity-records">
        {records.map((record, index) => (
          <article class={`integrity-record ${record.id} v3-reveal`} style={`--reveal-delay:${index * 70}ms`}>
            <div class="integrity-record-number">{record.number}</div>
            <div class="integrity-record-main">
              <div class="integrity-record-category">{record.category}</div>
              <h3>{record.title}</h3>
              <p class="integrity-context">{record.context}</p>
              <div class="integrity-record-columns">
                <div>
                  <h4>Work performed</h4>
                  <ul>{record.work.map((item) => <li>{item}</li>)}</ul>
                </div>
                <div>
                  <h4>Capabilities demonstrated</h4>
                  <div class="v3-methods">{record.demonstrates.map((item) => <span>{item}</span>)}</div>
                  <div class="integrity-limit"><strong>Evidence boundary</strong><p>{record.limitations}</p></div>
                </div>
              </div>
              <div class="v3-hero-actions">
                {record.links.map((link) => (
                  <a class="v3-button v3-button-small" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="v3-section" id="method">
      <div class="v3-section-head v3-reveal">
        <div>
          <div class="v3-kicker">Method</div>
          <h2>A reusable investigation workflow.</h2>
        </div>
        <p>Tools change, but the core process remains: define the claim, recover the best evidence, establish provenance, compare independent records and report only what survives scrutiny.</p>
      </div>
      <div class="integrity-method-grid">
        {methods.map(([title, body], index) => (
          <article class="integrity-method v3-reveal" style={`--reveal-delay:${(index % 3) * 60}ms`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="integrity-ethics v3-reveal">
      <div>
        <div class="v3-kicker">Ethical and legal boundary</div>
        <h2>Public records still require proportionate handling.</h2>
      </div>
      <div>
        <p>The portfolio focuses on public-interest knowledge, scientific claims, systems and attributable public records. Legally sensitive cases are described as source-recovery, chronology and editorial-policy work—not as independent legal findings.</p>
        <p>It does not publish private identifiers, doxxing material, confidential correspondence or methods designed to bypass legitimate access controls. Collection and disclosure should remain proportionate, authorized and documented under applicable privacy and safety rules.</p>
      </div>
    </section>

    <section class="v3-contact v3-reveal">
      <div>
        <div class="v3-kicker">Application lane</div>
        <h2>Trust, safety & knowledge integrity.</h2>
        <p>The current evidence supports analyst, research and operations roles involving public-source investigation, content governance, data quality and evidence-bound reporting. It does not support presenting the profile as an application-security engineer, penetration tester or covert investigator.</p>
      </div>
      <div class="v3-contact-links">
        <a href="/cv-integrity.html"><span>CV</span><strong>Trust & Knowledge Integrity</strong><span aria-hidden="true">↗</span></a>
        <a href="/security.html"><span>AI</span><strong>Model-behavior evaluation</strong><span aria-hidden="true">↗</span></a>
        <a href={D.identity.centralAuth} target="_blank" rel="noopener noreferrer"><span>Record</span><strong>Wikimedia CentralAuth</strong><span aria-hidden="true">↗</span></a>
        <a href={`mailto:${D.identity.email}`}><span>Email</span><strong>{D.identity.email}</strong><span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <SiteFooter version={D.identity.buildVersion} />

  <script is:inline>
    (function revealIntegrityPage() {
      var elements = Array.from(document.querySelectorAll(".v3-reveal"));
      var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion || !("IntersectionObserver" in window)) {
        elements.forEach(function(element) { element.classList.add("is-visible"); });
        return;
      }
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.1, rootMargin: "0px 0px -6% 0px" });
      elements.forEach(function(element) { observer.observe(element); });
    })();
  </script>
</Layout>
