---
const destination = "/notandia.html";
const canonical = "https://mariomarcolongo.com/notandia.html";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MDPI Filter moved to Notandia</title>
    <meta name="robots" content="noindex,follow" />
    <meta name="description" content="MDPI Filter has been rebranded as Notandia. Continue to the canonical current project page." />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <script is:inline define:vars={{ destination }}>window.location.replace(destination);</script>
  </head>
  <body>
    <main>
      <h1>MDPI Filter moved to Notandia</h1>
      <p>Notandia is the current public identity and continuation of MDPI Filter.</p>
      <p><a href={destination}>Open the canonical Notandia project page</a>.</p>
    </main>
  </body>
</html>

<style>
  :global(html) { color-scheme: light dark; font-family: system-ui, sans-serif; }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; }
  main { width: min(680px, calc(100% - 40px)); }
  h1 { font-size: clamp(2rem, 7vw, 4.5rem); line-height: 1; letter-spacing: -.045em; }
  p { font-size: 1.1rem; line-height: 1.6; }
</style>
